# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
APP_ENV=development
# Vacío = SQLite local. PostgreSQL: postgresql+psycopg://USUARIO:CLAVE@localhost:5432/sala_steam
DATABASE_URL=
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
LOCAL_UTC_OFFSET_HOURS=-5
# Simulador de datos DEMO (true = habilitado)
SIMULATOR_ENABLED=true
# PIN para registrar administradores desde la pantalla de registro (vacío = deshabilitado). Use uno largo y no lo comparta.
ADMIN_SIGNUP_PIN=
# Primer administrador (solo se crea si la base está vacía). Cambie la contraseña tras entrar.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador
